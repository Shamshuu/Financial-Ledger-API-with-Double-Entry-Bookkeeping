{
  "info": {
    "name": "Financial Ledger API",
    "description": "Complete API collection for testing the Financial Ledger API with Double-Entry Bookkeeping",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accountId1",
      "value": ""
    },
    {
      "key": "accountId2",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Create Checking Account (User A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('accountId1', jsonData.id);",
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Balance is 0', function () { pm.expect(jsonData.balance).to.eql(0); });",
                  "pm.test('Status is ACTIVE', function () { pm.expect(jsonData.status).to.eql('ACTIVE'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user-alice\",\n  \"accountType\": \"CHECKING\",\n  \"currency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["accounts"]
            }
          }
        },
        {
          "name": "Create Savings Account (User B)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('accountId2', jsonData.id);",
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user-bob\",\n  \"accountType\": \"SAVINGS\",\n  \"currency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["accounts"]
            }
          }
        },
        {
          "name": "Get Account Details (User A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Has balance field', function () { pm.expect(pm.response.json()).to.have.property('balance'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId1}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId1}}"]
            }
          }
        },
        {
          "name": "Get Account — Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', function () { pm.response.to.have.status(404); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/accounts/00000000-0000-0000-0000-999999999999",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "00000000-0000-0000-0000-999999999999"]
            }
          }
        }
      ]
    },
    {
      "name": "Deposits",
      "item": [
        {
          "name": "Deposit $1000 into Account A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.test('Type is DEPOSIT', function () { pm.expect(json.type).to.eql('DEPOSIT'); });",
                  "pm.test('Status is COMPLETED', function () { pm.expect(json.status).to.eql('COMPLETED'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId1}}\",\n  \"amount\": 1000.00,\n  \"description\": \"Initial deposit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/deposits",
              "host": ["{{baseUrl}}"],
              "path": ["deposits"]
            }
          }
        },
        {
          "name": "Deposit $500 into Account B",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId2}}\",\n  \"amount\": 500.00,\n  \"description\": \"Initial deposit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/deposits",
              "host": ["{{baseUrl}}"],
              "path": ["deposits"]
            }
          }
        },
        {
          "name": "Verify Account A Balance = $1000",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Balance is 1000', function () { pm.expect(pm.response.json().balance).to.eql(1000.0); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId1}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId1}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Transfers",
      "item": [
        {
          "name": "Transfer $250 from A to B",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.test('Type is TRANSFER', function () { pm.expect(json.type).to.eql('TRANSFER'); });",
                  "pm.test('Status is COMPLETED', function () { pm.expect(json.status).to.eql('COMPLETED'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": \"{{accountId1}}\",\n  \"destinationAccountId\": \"{{accountId2}}\",\n  \"amount\": 250.00,\n  \"description\": \"Payment for services\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["transfers"]
            }
          }
        },
        {
          "name": "Verify A Balance = $750",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Balance is 750', function () { pm.expect(pm.response.json().balance).to.eql(750.0); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId1}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId1}}"]
            }
          }
        },
        {
          "name": "Verify B Balance = $750",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Balance is 750', function () { pm.expect(pm.response.json().balance).to.eql(750.0); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId2}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId2}}"]
            }
          }
        },
        {
          "name": "Transfer — Insufficient Funds",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 422', function () { pm.response.to.have.status(422); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": \"{{accountId1}}\",\n  \"destinationAccountId\": \"{{accountId2}}\",\n  \"amount\": 99999.00,\n  \"description\": \"This should fail\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["transfers"]
            }
          }
        },
        {
          "name": "Transfer — Same Account (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": \"{{accountId1}}\",\n  \"destinationAccountId\": \"{{accountId1}}\",\n  \"amount\": 10.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["transfers"]
            }
          }
        }
      ]
    },
    {
      "name": "Withdrawals",
      "item": [
        {
          "name": "Withdraw $100 from Account A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.test('Type is WITHDRAWAL', function () { pm.expect(json.type).to.eql('WITHDRAWAL'); });",
                  "pm.test('Status is COMPLETED', function () { pm.expect(json.status).to.eql('COMPLETED'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId1}}\",\n  \"amount\": 100.00,\n  \"description\": \"ATM withdrawal\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/withdrawals",
              "host": ["{{baseUrl}}"],
              "path": ["withdrawals"]
            }
          }
        },
        {
          "name": "Verify A Balance = $650",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Balance is 650', function () { pm.expect(pm.response.json().balance).to.eql(650.0); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId1}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId1}}"]
            }
          }
        },
        {
          "name": "Withdrawal — Insufficient Funds",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 422', function () { pm.response.to.have.status(422); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId1}}\",\n  \"amount\": 99999.00,\n  \"description\": \"This should fail\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/withdrawals",
              "host": ["{{baseUrl}}"],
              "path": ["withdrawals"]
            }
          }
        }
      ]
    },
    {
      "name": "Ledger",
      "item": [
        {
          "name": "Get Ledger Entries for Account A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns array', function () { pm.expect(pm.response.json()).to.be.an('array'); });",
                  "pm.test('Has entries', function () { pm.expect(pm.response.json().length).to.be.above(0); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId1}}/ledger",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId1}}", "ledger"]
            }
          }
        },
        {
          "name": "Get Ledger — Account Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', function () { pm.response.to.have.status(404); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/accounts/00000000-0000-0000-0000-999999999999/ledger",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "00000000-0000-0000-0000-999999999999", "ledger"]
            }
          }
        }
      ]
    },
    {
      "name": "Validation",
      "item": [
        {
          "name": "Create Account — Missing Fields (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["accounts"]
            }
          }
        },
        {
          "name": "Transfer — Negative Amount (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": \"{{accountId1}}\",\n  \"destinationAccountId\": \"{{accountId2}}\",\n  \"amount\": -50.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["transfers"]
            }
          }
        }
      ]
    }
  ]
}
